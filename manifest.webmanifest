{
  "name": "Kandong – Habal Ride",
  "short_name": "Kandong",
  "description": "Rider & Passenger habal ride app with Supabase Realtime. Offline ready PWA.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0A0A0A",
  "theme_color": "#00C853",
  "lang": "tl-PH",
  "dir": "ltr",
  "categories": ["travel", "navigation", "lifestyle"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mag-book",
      "short_name": "Book",
      "description": "Mag-book ng rider",
      "url": "./index.html?action=book",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Rider Mode",
      "short_name": "Rider",
      "description": "Mag-online bilang rider",
      "url": "./index.html?mode=rider",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
